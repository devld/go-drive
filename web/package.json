{
  "name": "go-drive-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "description": "Web Application for go-drive",
  "scripts": {
    "dev": "vite --host",
    "build-monaco-editor": "npm run build --workspace=@go-drive/monaco-editor",
    "build-web": "vue-tsc --noEmit && vite build",
    "build": "npm run build-monaco-editor && npm run build-web",
    "preview": "vite preview",
    "lint": "vue-tsc --noEmit && eslint"
  },
  "dependencies": {
    "@go-drive/utils": "0.0.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.38",
    "vue-i18n": "^11.4.5",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/eslint-config-typescript": "^13.0.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.28.0",
    "rollup-plugin-visualizer": "^5.12.0",
    "sass": "^1.79.4",
    "typescript": "^5.6.2",
    "vite": "^8.2.2",
    "vite-plugin-html": "^3.2.2",
    "vue-tsc": "^2.1.6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devld/go-drive.git"
  },
  "license": "MIT",
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "trailingComma": "es5"
  }
}
